PORT=4000

# Opción A: Cadena de conexión directa (ej. Supabase Connection Pooler / URI)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Opción B: Parámetros de conexión discretos (PostgreSQL local o Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_SCHEMA=beautyproductsdb

# Orígenes permitidos por CORS (separados por coma si hay múltiples)
CORS_ORIGIN=http://localhost:5173
